#!/usr/bin/env bash
# wp-sr-promote: the owner's promoter and key generator for Puzzles Site Reports' signed updates. Review this file by
# hand and install it outside the repository (README, Release); re-installing a reviewed copy is the only way promotion
# changes. It runs nothing from the repository: it reads the release zips from GitHub as data, signs with PHP's sodium
# (php on PATH, else the image pinned below) and uploads with gh. Never run it in CI.
#
# Usage:
#   wp-sr-promote keygen 3>&1 1>&2 | <store-secret-from-stdin>
#       A new keypair: the base64 public key on stdout, the base64 secret key on file descriptor 3 only.
#   wp-sr-promote vX.Y.Z <tested> [--first] [--rotate] [--baseline-key <old public key>]
#       Promotes the pre-release vX.Y.Z. PUZZLES_SR_SIGNING_KEY: the secret key sites trust now (put it in this one
#       command's environment). <tested>: the WordPress version of its smoke test, typed by you (the release notes say
#       which; never paste a command from them). --first: no release was promoted yet. --rotate: the release ships a
#       new key, whose secret key is in PUZZLES_SR_NEW_SIGNING_KEY. --baseline-key: a rotation release was pulled and
#       you serve the sites that took it (README, Release); it needs that rotation release, still signed, as proof.
#   wp-sr-promote verify vX.Y.Z <zip> <public key>
#       Read-only: <zip> is the release vX.Y.Z whose manifest that key signed (a manual install).
#   wp-sr-promote pull vX.Y.Z [--delete-manifest]
#       Takes a bad release back: marks it pre-release, deletes its manifest.json (a rotation release keeps it unless
#       --delete-manifest; README, Release) and notes that this machine pulled it.
# Needs bash 4.4+, GNU coreutils, sed, grep, diff and cmp, unzip, python3, gh, and php with sodium or Docker.
#
# What it guarantees: nothing reaches the sites without the owner's key, and the owner sees exactly the files that ship.
#   1. Baseline: the highest-versioned release, pre-releases included, whose owner.sig (your key over its manifest)
#      verifies and whose zip has the manifest's sha256: what you promoted last, whoever can edit releases. It must be
#      GitHub's latest, not one this machine pulled, and not below the highest release this machine promoted and did
#      not pull (${XDG_CONFIG_HOME:-~/.config}/wp-sr-promote/promoted). No such release: only with --first.
#   2. Candidate: the tag's pre-release zip, at most 5 MB and stored, must be byte for byte build.sh's zip of its files
#      (so every unzip sees the same files), and its files must pass the checks below, each named by its refusal: names,
#      ASCII, `<?` only in PHP, the version, key, Update URI and URL lines, and the allowlist before the key define.
#   3. Review: the full diff of the two zips' files through `cat -v`, then the list of changed files; you type the
#      version on a terminal.
#   4. Sign `<version>\n<sha256>\n<requires>\n<requires_php>\n<tested>` with the key sites trust (manifest.json) and
#      with your current key (owner.sig: the same key, or the new one with --rotate), upload both, mark it latest, and
#      add it to this machine's list of promotions. A rerun finishes an interrupted promotion.
unset KEY NEWKEY KP # an exported variable of the same name would carry a key to every child
KEY="${PUZZLES_SR_SIGNING_KEY:-}"; NEWKEY="${PUZZLES_SR_NEW_SIGNING_KEY:-}"
unset PUZZLES_SR_SIGNING_KEY PUZZLES_SR_NEW_SIGNING_KEY
set -euo pipefail
umask 077
export GH_REPO=puzzles-consulting/wp-site-reports
USAGE="usage: wp-sr-promote vX.Y.Z <tested> [--first] [--rotate] [--baseline-key <old public key>] | verify vX.Y.Z <zip> <public key> | pull vX.Y.Z [--delete-manifest] | keygen (see the header)"
die() { echo "wp-sr-promote: $*" >&2; exit 1; }
(( BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 404 )) || die "needs bash 4.4 or later"
PHP_IMAGE=php:8.3-cli-alpine@sha256:e7699f91d3b46283a49bde02379266dd98d87844e08aed1ff7ea6a7d1f031268 # php:8.3-cli-alpine
php_run() { # php_run <php args...>: secrets on stdin only; the container has no network and no log
  if command -v php >/dev/null; then php "$@"; return; fi
  MSYS_NO_PATHCONV=1 docker run -i --rm --network none --log-driver none "$PHP_IMAGE" php "$@"
}
# crypto, stdin: "keypair" | "pub\n<secret>" | "sign\n<secret>\n<message>" | "verify\n<public>\n<signature>\n<message>"
crypto() {
  php_run -r '
$op = trim( (string) fgets( STDIN ) );
$b  = function ( $line, $len ) { $v = base64_decode( trim( (string) $line ), true ); return is_string( $v ) && $len === strlen( $v ) ? $v : null; };
if ( "keypair" === $op ) { $k = sodium_crypto_sign_keypair(); echo base64_encode( sodium_crypto_sign_publickey( $k ) ), " ", base64_encode( sodium_crypto_sign_secretkey( $k ) ); exit; }
if ( "verify" === $op ) {
	$pk = $b( fgets( STDIN ), SODIUM_CRYPTO_SIGN_PUBLICKEYBYTES );
	$s  = $b( fgets( STDIN ), SODIUM_CRYPTO_SIGN_BYTES );
	echo $pk && $s && sodium_crypto_sign_verify_detached( $s, stream_get_contents( STDIN ), $pk ) ? "valid" : "invalid";
	exit;
}
$k = $b( fgets( STDIN ), SODIUM_CRYPTO_SIGN_SECRETKEYBYTES );
if ( ! $k ) { fwrite( STDERR, "not a base64 Ed25519 secret key\n" ); exit( 1 ); }
echo base64_encode( "pub" === $op ? sodium_crypto_sign_publickey_from_secretkey( $k ) : sodium_crypto_sign_detached( stream_get_contents( STDIN ), $k ) );
' | tr -d '\r'
}
PY=python3; "$PY" -I -c '' 2>/dev/null || PY=python # python3 may be a Windows store stub
MAX=5242880 # the plugin's PUZZLES_SITE_REPORTS_MAX_PACKAGE
NOTE="${XDG_CONFIG_HOME:-$HOME/.config}/wp-sr-promote/promoted" # "<version> <sha256>" per line: every promotion here
PULLED="${NOTE%/*}/pulled"                                        # one version per line: every release pulled here
KEY_RE='^[A-Za-z0-9+/]{43}=$'
SIG_RE='^[A-Za-z0-9+/]{86}==$'
VER_RE='^[0-9]+\.[0-9]+(\.[0-9]+)?$'
TAG_RE='^v([0-9]+\.[0-9]+\.[0-9]+)$'
MAN_RE='^[{]"version":"([0-9.]+)","sha256":"([0-9a-f]{64})","requires":"([0-9.]+)","requires_php":"([0-9.]+)","tested":"([0-9.]+)","signature":"([A-Za-z0-9+/]{86}==)"[}]$'
PATH_RE='^puzzles-site-reports/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$' # every name a zip may hold
HP='^([[:blank:]]*<\?(php)?)?[[:blank:]/*#@]*' # the prefix of a header line as get_file_data() reads it (any case)
sha_of() { sha256sum "$1" | cut -c1-64; }
manifest() { # manifest <file> <version>: sets F (version, sha256, requires, requires_php, tested, signature) and MSG
  local m
  m=$(head -c 1024 "$1" 2>/dev/null | tr -d '\r\n' || true)
  [[ "$m" =~ $MAN_RE ]] && [ "${BASH_REMATCH[1]}" = "$2" ] || return 1
  F=("${BASH_REMATCH[@]:1}")
  MSG="${F[0]}"$'\n'"${F[1]}"$'\n'"${F[2]}"$'\n'"${F[3]}"$'\n'"${F[4]}"
}
verified() { [ "$(printf 'verify\n%s\n%s\n%s' "$1" "$2" "$3" | crypto)" = valid ]; } # verified <public> <signature> <message>
pulled() { grep -qxF "$1" "$PULLED" 2>/dev/null; } # pulled <version>: this machine pulled it
key_in() { sed -n "s/^define( 'PUZZLES_SR_UPDATE_PUBKEY', '\([^']*\)' );\$/\1/p" "$1"; } # key_in <main file>
promoted() { # promoted <tag> <public key>: its manifest, an owner.sig by that key over it, and the zip it names ($W/r/<tag>)
  local d="$W/r/$1" s
  mkdir -p "$d"
  [ -f "$d/manifest.json" ] || fetch_asset "$1" manifest.json "$d/manifest.json" 1024 || return 1
  manifest "$d/manifest.json" "${1#v}" || return 1
  [ -f "$d/owner.sig" ] || fetch_asset "$1" owner.sig "$d/owner.sig" 200 || return 1
  s=$(tr -d '\r\n' <"$d/owner.sig")
  [[ "$s" =~ $SIG_RE ]] && verified "$2" "$s" "$MSG" || return 1
  [ -f "$d/puzzles-site-reports.zip" ] || fetch_asset "$1" puzzles-site-reports.zip "$d/puzzles-site-reports.zip" $MAX || return 1
  [ "$(sha_of "$d/puzzles-site-reports.zip")" = "${F[1]}" ]
}
fetch_asset() { # fetch_asset <tag> <asset> <file> <cap>: at most <cap> + 1 bytes of it; 1 if it has none or is bigger
  local u
  u=$(gh release view "$1" --json assets --jq ".assets[] | select(.name == \"$2\") | .apiUrl") || die "could not read $1's assets"
  [[ "$u" =~ /releases/assets/([0-9]+)$ ]] || return 1
  if ! gh api "repos/$GH_REPO/releases/assets/${BASH_REMATCH[1]}" -H 'Accept: application/octet-stream' | head -c $(($4 + 1)) >"$3"; then
    [ "$(wc -c <"$3")" -gt "$4" ] || die "could not download $1's $2"
  fi
  [ "$(wc -c <"$3")" -le "$4" ]
}
# zipx <tag> <zip> [<dir>]: the zip exactly as build.sh lays it out (every local header equal to its central entry,
# stored, plain, contiguous from the start, CRCs, regular files, names that pass PATH_RE), checked before anything is
# written; then its names, or exactly those entries written under <dir>. Run it from $W with relative paths.
zipx() {
  "$PY" -I - "$PATH_RE" "$@" <<'ZIPEOF'
import os, re, struct, sys, zlib
path_re, tag, path = sys.argv[1:4]
def fail(m):
    sys.exit("wp-sr-promote: %s's zip %s" % (tag, m))
d = open(path, 'rb').read()
if len(d) < 22 or d[-22:-18] != b'PK\x05\x06':
    fail('does not end in an end record without a comment, as build.sh writes')
n1, n, cdsize, cdoff, clen = struct.unpack('<HHIIH', d[-14:])
if n1 != n or clen or cdoff + cdsize != len(d) - 22 or d[-18:-14] != bytes(4):
    fail('has an end record that does not match its central directory')
if not n:
    fail('is empty')
files, off, p = [], 0, cdoff
for _ in range(n):
    if p + 46 > cdoff + cdsize or d[p:p + 4] != b'PK\x01\x02':
        fail('has a broken central directory')
    _, _, _, fl, meth, _, _, crc, cs, us, nl, xl, ml, _, _, ea, lho = struct.unpack('<4sHHHHHHIIIHHHHHII', d[p:p + 46])
    name = d[p + 46:p + 46 + nl]
    p += 46 + nl + xl + ml
    if any(b < 0x21 or b > 0x7e for b in name):
        fail('has a name with a byte that is not printable ASCII: %r' % name)
    name = name.decode('ascii')
    if not re.fullmatch(path_re, name):
        fail('has the entry %r' % name)
    if (ea >> 16) & 0o170000 != 0o100000:
        fail('holds something other than regular files (a link or a directory)')
    if meth or fl or cs != us or xl or ml:
        fail('has a compressed entry, or flags or extra fields: build.sh stores every file plainly')
    if lho != off or off + 30 > cdoff:
        fail('has entries that are not one after another from its start (overlapping, or with gaps)')
    lsig, _, lfl, lmeth, _, _, lcrc, lcs, lus, lnl, lxl = struct.unpack('<4sHHHHHIIIHH', d[off:off + 30])
    if lsig != b'PK\x03\x04' or (lfl, lmeth, lcrc, lcs, lus, lxl) != (fl, meth, crc, cs, us, 0) or d[off + 30:off + 30 + lnl] != name.encode():
        fail('has a local header that differs from its central entry')
    off += 30 + lnl + cs
    if off > cdoff or zlib.crc32(d[off - cs:off]) != crc:
        fail('has an entry whose data runs into the central directory or fails its CRC')
    files.append((name, off - cs, off))
if off != cdoff or p != cdoff + cdsize:
    fail('has bytes outside its entries and central directory')
if len(sys.argv) < 5:
    sys.stdout.buffer.write(('\n'.join(f[0] for f in files) + '\n').encode())
    sys.exit()
for name, a, b in files:
    t = os.path.join(sys.argv[4], *name.split('/'))
    os.makedirs(os.path.dirname(t), exist_ok=True)
    with open(t, 'xb') as f:  # 'x': a name twice is refused, never overwritten
        f.write(d[a:b])
ZIPEOF
}
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
mkdir "$W/r" "$W/new" "$W/cand" "$W/base"

if [ "${1:-}" = keygen ]; then
  [ $# -eq 1 ] || die "$USAGE"
  { true >&3; } 2>/dev/null || die "keygen: open file descriptor 3 for the secret key (see the header)"
  KP=$(echo keypair | crypto)
  [[ "${KP%% *}" =~ $KEY_RE && "${KP#* }" =~ ^[A-Za-z0-9+/]{86}==$ ]] || die "keygen: PHP gave no keypair"
  printf '%s' "${KP#* }" >&3
  printf '%s\n' "${KP%% *}"
  exit 0
fi

if [ "${1:-}" = verify ]; then
  [ $# -eq 4 ] && [[ "$4" =~ $KEY_RE && "$2" =~ $TAG_RE ]] || die "$USAGE"
  VV=${BASH_REMATCH[1]}
  fetch_asset "$2" manifest.json "$W/r/manifest.json" 1024 && manifest "$W/r/manifest.json" "$VV" || die "$2 has no manifest.json this script wrote: it was never promoted, or it was pulled"
  [ "$(sha_of "$3")" = "${F[1]}" ] || die "$3 is not the zip $2's manifest names (sha256 ${F[1]})"
  verified "$4" "${F[5]}" "$MSG" || die "$2's manifest is not signed by $4 (for a rotation release, pass the key of the release before it)"
  echo "ok: $3 is $2, as signed by $4"
  exit 0
fi

if [ "${1:-}" = pull ]; then
  case "$#:${3:-}" in 2: | 3:--delete-manifest) ;; *) die "$USAGE" ;; esac
  [[ "$2" =~ $TAG_RE ]] || die "$USAGE"
  PV=${BASH_REMATCH[1]}; ROT=""; HAS=""
  ASSETS=$(gh release view "$2" --json assets --jq '.assets[].name') || die "could not read $2's assets"
  ! grep -qxF manifest.json <<<"$ASSETS" || HAS=1
  gh release edit "$2" --prerelease # first: no site is offered it from here on
  mkdir -p "${PULLED%/*}"; pulled "$PV" || echo "$PV" >>"$PULLED"
  if [ -n "$HAS" ] && [ -z "${3:-}" ]; then
    # A rotation release: its owner.sig over its manifest verifies with the key its zip ships, its zip is the one the
    # manifest names, and the manifest itself does not verify with that key (the previous key signed it).
    [ "$(echo keypair | crypto 2>/dev/null | wc -w)" = 2 ] \
      || die "$2 is pre-release now, but telling whether it is a rotation release needs php or Docker: run this where one works, or with --delete-manifest"
    mkdir "$W/r/z"
    if fetch_asset "$2" manifest.json "$W/r/manifest.json" 1024 && manifest "$W/r/manifest.json" "$PV" \
      && fetch_asset "$2" owner.sig "$W/r/owner.sig" 200 && fetch_asset "$2" puzzles-site-reports.zip "$W/r/z.zip" $MAX \
      && (cd "$W" && zipx "$2" r/z.zip r/z 2>/dev/null); then
      K=$(key_in "$W/r/z/puzzles-site-reports/puzzles-site-reports.php" 2>/dev/null || true); S=$(tr -d '\r\n' <"$W/r/owner.sig")
      [[ "$K" =~ $KEY_RE && "$S" =~ $SIG_RE ]] && verified "$K" "$S" "$MSG" && [ "$(sha_of "$W/r/z.zip")" = "${F[1]}" ] \
        && ! verified "$K" "${F[5]}" "$MSG" && ROT=1
    fi
  fi
  if [ -n "$ROT" ]; then
    echo "wp-sr-promote: $2 is a rotation release: its manifest.json stays, since --baseline-key needs it until you choose which sites to serve (README, Release). To delete it: wp-sr-promote pull $2 --delete-manifest" >&2
  elif [ -n "$HAS" ]; then
    gh release delete-asset "$2" manifest.json --yes
  fi
  echo "pulled $2"
  exit 0
fi

FIRST=""; ROTATE=""; BASEKEY=""; POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --first) FIRST=1 ;;
    --rotate) ROTATE=1 ;;
    --baseline-key) BASEKEY=${2:?--baseline-key needs a public key}; shift; [[ "$BASEKEY" =~ $KEY_RE ]] || die "--baseline-key takes a base64 public key" ;;
    -*) die "unknown argument: $1" ;;
    *) POS+=("$1") ;;
  esac
  shift
done
[ ${#POS[@]} -eq 2 ] && [[ "${POS[0]}" =~ $TAG_RE ]] || die "$USAGE"
TAG=${POS[0]}; V=${BASH_REMATCH[1]}; TESTED=${POS[1]}
[[ "$TESTED" =~ $VER_RE ]] || die "bad tested: ${TESTED@Q}"
[ -n "$KEY" ] || die "PUZZLES_SR_SIGNING_KEY is not set"
if [ -n "$ROTATE" ]; then [ -n "$NEWKEY" ] || die "--rotate needs the new secret key in PUZZLES_SR_NEW_SIGNING_KEY"
else [ -z "$NEWKEY" ] || die "PUZZLES_SR_NEW_SIGNING_KEY is set without --rotate"; fi
PUB=$(printf 'pub\n%s\n' "$KEY" | crypto); [[ "$PUB" =~ $KEY_RE ]] || die "PUZZLES_SR_SIGNING_KEY is not a base64 Ed25519 secret key"
OWN=$PUB # the key the release ships, and owner.sig's
if [ -n "$ROTATE" ]; then
  OWN=$(printf 'pub\n%s\n' "$NEWKEY" | crypto); [[ "$OWN" =~ $KEY_RE ]] || die "PUZZLES_SR_NEW_SIGNING_KEY is not a base64 Ed25519 secret key"
  [ "$OWN" != "$PUB" ] || die "--rotate, but the new key is the current one"
fi
ROTHINT="A key rotation involved? README, Release."
# The floor: the highest version this machine promoted and did not pull.
FLOOR=$([ ! -f "$NOTE" ] || cut -d' ' -f1 "$NOTE" | grep -vxF -f <(cat "$PULLED" 2>/dev/null) | sort -V | tail -1 || true)
note() { # note <version> <sha256>: one more promotion of this machine, no longer pulled
  mkdir -p "${NOTE%/*}" && { grep -qxF "$1 $2" "$NOTE" 2>/dev/null || echo "$1 $2" >>"$NOTE"; } \
    || echo "wp-sr-promote: could not write $NOTE" >&2
  [ ! -f "$PULLED" ] || { grep -vxF "$1" "$PULLED" >"$PULLED.new" || true; mv "$PULLED.new" "$PULLED"; }
}

# 1. The baseline: the newest release you promoted, which must be GitHub's latest.
if LATEST=$(gh api "repos/$GH_REPO/releases/latest" --jq .tag_name 2>"$W/gh-err"); then LATEST=$(tr -d '\r' <<<"$LATEST")
else grep -q 'HTTP 404' "$W/gh-err" || { cat "$W/gh-err" >&2; die "could not read the latest release"; }; LATEST=""; fi
if [ "$LATEST" = "$TAG" ] && promoted "$TAG" "$OWN" && verified "$PUB" "${F[5]}" "$MSG"; then
  note "$V" "${F[1]}"; echo "$TAG is already the latest release, signed by you: nothing to do"; exit 0
fi
TAGLIST=$(gh api "repos/$GH_REPO/releases?per_page=100" --paginate --jq '.[].tag_name') || die "could not list the releases"
mapfile -t TAGS < <(tr -d '\r' <<<"$TAGLIST" | grep -E "$TAG_RE" | sort -rV || true)
BK=${BASEKEY:-$PUB}; BASE=""
for t in "${TAGS[@]}"; do
  [ "$t" != "$TAG" ] && promoted "$t" "$BK" && { BASE=$t; RSHA=${F[1]}; break; }
done
if [ -z "$BASE" ]; then
  [ -z "$LATEST" ] || die "no release has an owner.sig that verifies with $BK, so GitHub's latest, $LATEST, is not one you promoted. $ROTHINT"
  [ -n "$FIRST" ] || die "GitHub has no latest release and none you promoted: pass --first if this is the first promotion (everything shows as new)"
  [ -z "$ROTATE$BASEKEY" ] || die "--rotate or --baseline-key, but no release was promoted yet"
  [ -z "$FLOOR" ] || die "--first, but this machine promoted $FLOOR and did not pull it ($NOTE): find out where that release went"
  TRUSTED=$PUB; BL="none (--first): everything is new"
else
  [ -z "$FIRST" ] || die "--first, but $BASE is a release you promoted"
  ! pulled "${BASE#v}" || die "the newest release you promoted, $BASE, was pulled on this machine, yet it is still signed (a rotation release keeps its manifest): serve its sites with --baseline-key <old public key>, or the others as usual (README, Release)"
  [ "$LATEST" = "$BASE" ] || [ "$LATEST" = "$TAG" ] \
    || die "GitHub's latest release is ${LATEST:-none}, but the newest release you promoted (owner.sig by $BK) is $BASE: finish it (rerun its promotion) or pull it (README, Release), or mark it latest again once you know why. $ROTHINT"
  BL="$BASE (owner.sig verified, GitHub's latest)"
  (cd "$W" && zipx "$BASE" "r/$BASE/puzzles-site-reports.zip" base)
  TRUSTED=$(key_in "$W/base/puzzles-site-reports/puzzles-site-reports.php")
  REF=$BASE # what the sites you sign for run: the baseline, or with --baseline-key the rotation release they took
  if [ -n "$BASEKEY" ]; then # the newest release you promoted with your key must be a rotation from BASEKEY to it
    REF=""
    for t in "${TAGS[@]}"; do [ "$t" != "$TAG" ] && promoted "$t" "$PUB" && { REF=$t; RSHA=${F[1]}; break; }; done
    [ -n "$REF" ] || die "--baseline-key: no release you promoted with your key, so none proves a rotation from $BASEKEY to it"
    unzip -p "$W/r/$REF/puzzles-site-reports.zip" puzzles-site-reports/puzzles-site-reports.php >"$W/r/$REF/main.php"
    verified "$BASEKEY" "${F[5]}" "$MSG" && [ "$(key_in "$W/r/$REF/main.php")" = "$PUB" ] \
      || die "--baseline-key: the newest release you promoted with your key, $REF, is not a rotation from $BASEKEY to it (shipping your key, its manifest signed by $BASEKEY)"
    TRUSTED=$PUB; BL+="; the sites that took the rotation release $REF trust your key"
  fi
  for r in "$BASE" ${BASEKEY:+"$REF"}; do
    printf '%s\n' "${r#v}" "$V" | sort -VCu || die "$TAG is not newer than $r, a release you promoted"
  done
  if [ -s "$NOTE" ]; then
    [ -z "$FLOOR" ] || printf '%s\n' "$FLOOR" "${REF#v}" | sort -VC \
      || die "the baseline, $REF, is below $FLOOR, the highest release this machine promoted and did not pull ($NOTE): find out why before promoting (if you pulled v$FLOOR elsewhere, run \`wp-sr-promote pull v$FLOOR\` here)"
    ! cut -d' ' -f1 "$NOTE" | grep -qxF "${REF#v}" || grep -qxF "${REF#v} $RSHA" "$NOTE" \
      || die "the baseline, $REF, is not the zip this machine promoted as $REF ($NOTE): find out why before promoting"
  else BL+="; baseline taken from GitHub only (no $NOTE)"; fi
fi
TOPPULL=$(grep -vxF "$V" "$PULLED" 2>/dev/null | sort -V | tail -1 || true)
[ -z "$TOPPULL" ] || printf '%s\n' "$TOPPULL" "$V" | sort -VCu \
  || die "$TAG is not newer than $TOPPULL, which this machine pulled and sites may run: roll forward past it"
[ "$PUB" = "$TRUSTED" ] || die "your signing key's public key ($PUB) is not the one sites trust now ($TRUSTED), or you are signing with the key from before a rotation"

# 2. The candidate: the tag's pre-release zip, checked as it is.
Z="$W/new/puzzles-site-reports.zip"
fetch_asset "$TAG" puzzles-site-reports.zip "$Z" $MAX || die "$TAG's zip is missing or over $MAX bytes, which sites refuse"
DEV_RE='/(con|prn|aux|nul|com[0-9]|lpt[0-9])(\.[^/]*)?/'
declare -A SEEN # lowercased path -> f (a file) or d (a directory)
NAMES_OUT=$(cd "$W" && zipx "$TAG" new/puzzles-site-reports.zip) || exit 1
mapfile -t NAMES <<<"$NAMES_OUT" # zipx checked PATH_RE; these checks add Windows' rules
for p in "${NAMES[@]}"; do
  l=${p,,}
  [[ ! "/$l/" =~ $DEV_RE ]] || die "$TAG's ${p@Q} has a reserved device name on Windows"
  [[ "$p/" != *./* ]] || die "$TAG's ${p@Q} has a name ending in '.', which Windows drops"
  [ -z "${SEEN[$l]:-}" ] || die "$TAG's ${p@Q} and another entry are one name on Windows (case-insensitive)"
  SEEN[$l]=f; d=$l
  while [[ "$d" == */* ]]; do
    d=${d%/*}; [ "${SEEN[$d]:-d}" = d ] || die "$TAG's ${p@Q} and another entry are one name on Windows (case-insensitive)"
    SEEN[$d]=d
  done
done
(cd "$W" && zipx "$TAG" new/puzzles-site-reports.zip cand) || exit 1
f=$(cd "$W/cand" && { LC_ALL=C grep -rlaUE $'[^\t -~]' . || true; } | head -1); f=${f#./}
[ -z "$f" ] || die "$TAG's ${f@Q} has a byte other than TAB, LF and printable ASCII"
f=$(cd "$W/cand" && { grep -rlF '<?' --exclude='*.php' . || true; } | head -1); f=${f#./}
[ -z "$f" ] || die "$TAG's ${f@Q} is not PHP but holds a PHP open tag ('<?'): included, it would run"
MAINF="$W/cand/puzzles-site-reports/puzzles-site-reports.php"
[ -f "$MAINF" ] || die "$TAG has no puzzles-site-reports.php"
hdr_count() { grep -ciE "${HP}$1:" "$MAINF" || true; } # lines get_file_data() could read as header <name>
wp_header() { # wp_header <name>: as get_file_data() reads it (first 8 KB, first match, cut at */ or ?>)
  head -c 8192 "$MAINF" | grep -iE "${HP}$1:" | head -1 \
    | sed -E "s/${HP}$1:(.*)\$/\3/I; s/[[:space:]]*(\*\/|\?>).*//; s/^[[:blank:]]+//; s/[[:blank:]]+\$//"
}
exactly() { [ "$(grep -cF "$1" "$MAINF" || true)" = 1 ] && grep -qxF "$2" "$MAINF"; } # exactly <mention> <the one line>
[ "$(hdr_count Version)" = 1 ] && grep -qxF " * Version: $V" "$MAINF" && [ "$(wp_header Version)" = "$V" ] \
  && exactly "PUZZLES_SITE_REPORTS_VERSION'" "define( 'PUZZLES_SITE_REPORTS_VERSION', '$V' );" \
  || die "$TAG's main file needs exactly one version header line as WordPress reads it, ' * Version: $V', and exactly one \"define( 'PUZZLES_SITE_REPORTS_VERSION', '$V' );\""
[ "$(hdr_count 'Update URI')" = 1 ] && [ "$(wp_header 'Update URI')" = https://github.com/puzzles-consulting/wp-site-reports ] \
  && exactly "PUZZLES_SITE_REPORTS_MANIFEST_URL'" "define( 'PUZZLES_SITE_REPORTS_MANIFEST_URL', 'https://github.com/puzzles-consulting/wp-site-reports/releases/latest/download/manifest.json' );" \
  && exactly "PUZZLES_SITE_REPORTS_PACKAGE_PREFIX'" "define( 'PUZZLES_SITE_REPORTS_PACKAGE_PREFIX', 'https://github.com/puzzles-consulting/wp-site-reports/releases/download/' );" \
  || die "$TAG's main file must keep the exact Update URI header, manifest URL and package prefix"
KEYLINE="^define\\( 'PUZZLES_SR_UPDATE_PUBKEY', '[A-Za-z0-9+/]{43}=' \\);\$"
[ "$(grep -cE "$KEYLINE" "$MAINF" || true)" = 1 ] \
  || die "$TAG's main file needs its key on one top-level line: define( 'PUZZLES_SR_UPDATE_PUBKEY', '<base64 key>' );"
DEFL=$(grep -nE "$KEYLINE" "$MAINF" | cut -d: -f1)
mapfile -t PRE < <(head -n $((DEFL - 1)) "$MAINF")
Q="'"; LITDEF="^define\\( ${Q}[A-Z0-9_]+${Q}, (${Q}[^${Q}\\\\]*${Q}|[0-9]+) \\);\$" # define( 'NAME', 'literal' or 123 );
before() { die "$TAG's main file has ${1@Q} before its key define: only the header comment, blank lines, // comments, the ABSPATH guard and literal define( 'NAME', 'value' ); lines may come first"; }
[ "${PRE[0]:-}" = '<?php' ] || before "${PRE[0]:-}"
INC=""
for (( i = 1; i < ${#PRE[@]}; i++ )); do
  l=${PRE[i]}
  if [ -n "$INC" ]; then # inside the header comment: nothing may end it but its own " */" line
    if [ "$l" = ' */' ]; then INC=""; else [[ "$l" != *'*/'* ]] || before "$l"; fi
    continue
  fi
  case "$l" in
    '/**') INC=1 ;;
    '') ;;
    "if ( ! defined( 'ABSPATH' ) ) {") [ "${PRE[i+1]:-}" = $'\texit;' ] && [ "${PRE[i+2]:-}" = '}' ] || before "$l"; i=$((i + 2)) ;;
    //*) [[ "$l" != *'?>'* ]] || before "$l" ;; # ?> would end PHP inside a // comment
    *) [[ "$l" =~ $LITDEF && "$l" != *PUZZLES_SR_UPDATE_PUBKEY* ]] || before "$l" ;;
  esac
done
[ -z "$INC" ] || before '/**'
NEWPUB=$(key_in "$MAINF")
[ "$NEWPUB" = "$OWN" ] || die "$TAG ships the key $NEWPUB, not $OWN$([ -n "$ROTATE" ] || echo ': pass --rotate (with PUZZLES_SR_NEW_SIGNING_KEY) if a new key is intended')"
REQ=$(wp_header 'Requires at least'); REQPHP=$(wp_header 'Requires PHP')
[[ "$REQ" =~ $VER_RE && "$REQPHP" =~ $VER_RE ]] || die "bad Requires header: ${REQ@Q} ${REQPHP@Q}"
# zipx checked the layout; build.sh's zip of the same files must also be the candidate byte for byte, so the order,
# timestamps and attributes are build.sh's too.
(cd "$W" && "$PY" -I - cand <<'PYEOF'
import os, sys, zipfile
src = sys.argv[1]
names = sorted(os.path.relpath(os.path.join(d, f), src).replace(os.sep, '/') for d, _, fs in os.walk(src) for f in fs)
with zipfile.ZipFile('puzzles-site-reports.zip', 'w') as z:
    for n in names:
        i = zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0))  # ZIP_STORED by default
        i.create_system = 3                              # Unix, whatever machine builds it
        i.external_attr = 0o100644 << 16                 # a regular file, rw-r--r--
        with open(os.path.join(src, n), 'rb') as f:
            z.writestr(i, f.read())
print('\n'.join(names))
PYEOF
) >/dev/null
cmp -s "$W/puzzles-site-reports.zip" "$Z" || die "$TAG's zip is not build.sh's zip of its own files, byte for byte: refused whatever it shows"

# 3. The review.
SHA=$(sha_of "$Z")
{
  echo "wp-sr-promote: baseline: $BL"
  echo "wp-sr-promote: candidate: $TAG, zip sha256 $SHA; every file it ships, baseline -> $TAG, in full:"
  (cd "$W" && diff -ruN --text base cand || true) | cat -v
  echo "wp-sr-promote: in short:"
  (cd "$W" && diff -qrN base cand || true) | cat -v
  echo "wp-sr-promote: check that the portal's Companion column shows no version newer than ${REF:-none}, what the sites you sign for run$([ ! -s "$PULLED" ] || echo ", or than a release this machine pulled: $(sort -V "$PULLED" | paste -sd' ')")."
} >&2
[ -t 0 ] && [ -t 2 ] || die "the review is shown on a terminal and confirmed from it, never from a pipe or a file"
printf 'wp-sr-promote: review the diff above, then type %s to sign %s: ' "$V" "$TAG" >&2
read -r ANS || true
[ "$ANS" = "$V" ] || die "not confirmed"

# 4. Sign, upload, mark latest, note.
NMSG="$V"$'\n'"$SHA"$'\n'"$REQ"$'\n'"$REQPHP"$'\n'"$TESTED"
SIG=$(printf 'sign\n%s\n%s' "$KEY" "$NMSG" | crypto)
OWNSIG=$SIG; [ -z "$ROTATE" ] || OWNSIG=$(printf 'sign\n%s\n%s' "$NEWKEY" "$NMSG" | crypto)
[[ "$SIG" =~ $SIG_RE && "$OWNSIG" =~ $SIG_RE ]] || die "signing failed"
printf '{"version":"%s","sha256":"%s","requires":"%s","requires_php":"%s","tested":"%s","signature":"%s"}\n' \
  "$V" "$SHA" "$REQ" "$REQPHP" "$TESTED" "$SIG" >"$W/manifest.json"
printf '%s\n' "$OWNSIG" >"$W/owner.sig"
gh release upload "$TAG" "$W/manifest.json" "$W/owner.sig" --clobber
gh release edit "$TAG" --prerelease=false --latest
note "$V" "$SHA"
[ -z "$ROTATE" ] || echo "wp-sr-promote: rotated: sites that take $TAG trust only $OWN; promote with the new key from now on" >&2
echo "promoted $TAG (zip sha256 $SHA)"
