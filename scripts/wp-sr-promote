#!/usr/bin/env bash
# wp-sr-promote: the whole promoter and key generator of Puzzles Site Reports' signed updates. The owner reviews this
# file by hand and installs it outside the repository (README, Release); re-installing a reviewed copy is the only way
# promotion changes. It runs NOTHING from the repository: the tag's files are read as git blobs (data), the zip is built
# here (the same bytes as scripts/build.sh, which CI uses; the test proves it), the signature is made by PHP's sodium
# (php on PATH, else the image pinned below), and the manifest is uploaded with gh. Never in CI: the key never lives in
# GitHub.
#
# Usage:
#   wp-sr-promote keygen 3>&1 1>&2 | <store-secret-from-stdin>
#       A new release keypair: the base64 public key on stdout (it goes into PUZZLES_SR_UPDATE_PUBKEY), the base64
#       secret key on file descriptor 3 only (never an argument, a file or the terminal).
#   wp-sr-promote --repo <clone> vX.Y.Z <tested> [--rotate]
#       PUZZLES_SR_SIGNING_KEY: the secret key sites trust now; with --rotate (the tag ships a new
#       PUZZLES_SR_UPDATE_PUBKEY) also PUZZLES_SR_NEW_SIGNING_KEY, its secret key, as proof. The release is signed with
#       the key sites trust now. <tested>: the WordPress version of the release's smoke test, typed by the owner (the
#       release notes say which; never paste a command from them). Put the keys in this one command's environment.
#   wp-sr-promote --repo <throwaway clone> vX.Y.Z <tested> --dry-run <zip> [--trusted-zip <zip>] [--rotate]
#       Every check and the signature, with <zip> standing in for the release's asset and <trusted-zip> for GitHub's
#       latest release (without it: no key, version or record check), no gh call, no origin URL check; prints the
#       manifest. Keys: PUZZLES_SR_DRY_RUN_KEY (and PUZZLES_SR_DRY_RUN_NEW_KEY), throwaway ones only: the release key
#       variables are refused, and so is a key found in the clone's HEAD history. Dry runs and real runs never share a
#       clone. To dry-run a real tag, use a throwaway clone without --trusted-zip.
# The keys are copied and unset first: no child process inherits one; PHP gets them on stdin.
# Needs bash 4.4+, GNU sed and coreutils, git 2.40+, python3 (or python), unzip, gh, and php with sodium or Docker.
#
# The control is the owner's review of what step 3 prints; the checks make it complete and hard to disguise.
#   1. The tag is one commit, the same locally and on origin (exact `refs/tags/vX.Y.Z` in `git ls-remote --tags`), on
#      origin's main; origin is github.com/puzzles-consulting/wp-site-reports (real runs). No fetch refspec may write
#      outside refs/remotes/ and refs/tags/ (the record below is local).
#   2. GitHub's latest release gives the key and version sites have now: its tag must be v<the version in its zip>, and
#      its manifest must match its zip and verify with the key of a promotion recorded (or pending) in this clone (its
#      own key only when the clone has none; a rotation release is signed with the old key, so a clone needs the record
#      of the release before it too). The baseline is the owner's record, refs/puzzles-sr/promoted/vX.Y.Z -> the commit
#      signed, written only by this script (refs/puzzles-sr/pending/vX.Y.Z, holding the commit and the zip's sha256,
#      just before it goes live), local only (never push it or fetch into it); it is only the baseline of the review,
#      never trusted code. The latest release must be one recorded here (after a bad release is marked pre-release, an
#      older recorded one is latest again) and carry the key of the highest record. If it is instead the pending one of
#      a run stopped after it went live, with the zip that run signed, the owner is offered to record it. A record is
#      trusted only as the commit that was signed: the latest release's record and the highest one must each build here
#      to the zip their signed manifest names (a dry run checks the latest's against --trusted-zip). The tag must be
#      newer than both the latest release and the highest record. No record (the first promotion in this clone): the
#      baseline is empty and everything is new.
#   3. Only the shipped files are read from the tag's tree, as blobs: each path is one shipped name or under includes/,
#      writes as itself on Linux and Windows inside the staging directory, and is a regular file; no git attribute may
#      change one on checkout (CI builds from a checkout). Every shipped file is plain ASCII, so nothing (no control
#      byte, no binary such as an archive) can hide from the printed diff, and no file but PHP holds a PHP open tag. The
#      version WordPress reads and the version constant are each on exactly one line, the lines the build rewrites. The
#      key is defined on one top-level line, and nothing before it can run: only the header comment, blank lines, line
#      comments, the ABSPATH guard and literal defines come first. PHP keeps a constant's first define, so no later code
#      can change the key. A few tripwires remain (the key named only in the main file, no phar, no constant tricks they
#      can see). Then it prints, through `cat -v`, the tag's commit, the full diff of every shipped file from the record
#      to the tag and its --stat, and the owner types the version (a real run: on a terminal, never piped).
#   4. It builds the zip from those files and requires the release zip to have the same sha256; signs
#      `<version>\n<sha256>\n<requires>\n<requires_php>\n<tested>` with the key sites trust now (the tag keeps it
#      unless --rotate proves the new one); uploads manifest.json, marks the release latest and records it (2).
unset KEY NEWKEY DKEY DNEWKEY KP # an exported variable of the same name would carry a key to every child
KEY="${PUZZLES_SR_SIGNING_KEY:-}"; NEWKEY="${PUZZLES_SR_NEW_SIGNING_KEY:-}"
DKEY="${PUZZLES_SR_DRY_RUN_KEY:-}"; DNEWKEY="${PUZZLES_SR_DRY_RUN_NEW_KEY:-}"
unset PUZZLES_SR_SIGNING_KEY PUZZLES_SR_NEW_SIGNING_KEY PUZZLES_SR_DRY_RUN_KEY PUZZLES_SR_DRY_RUN_NEW_KEY
set -euo pipefail
umask 077
export GIT_NO_REPLACE_OBJECTS=1 GH_REPO=puzzles-consulting/wp-site-reports
die() { echo "wp-sr-promote: $*" >&2; exit 1; }
(( BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 404 )) || die "needs bash 4.4 or later"
PHP_IMAGE=php:8.3-cli-alpine@sha256:e7699f91d3b46283a49bde02379266dd98d87844e08aed1ff7ea6a7d1f031268 # php:8.3-cli-alpine
php_run() { # php_run <php args...>: secrets on stdin only; the container has no network and no log
  if command -v php >/dev/null; then php "$@"; return; fi
  MSYS_NO_PATHCONV=1 docker run -i --rm --network none --log-driver none "$PHP_IMAGE" php "$@"
}
KEY_RE='^[A-Za-z0-9+/]{43}=$'
VER_RE='^[0-9]+\.[0-9]+(\.[0-9]+)?$'

if [ "${1:-}" = keygen ]; then
  [ $# -eq 1 ] || die "usage: wp-sr-promote keygen 3>&1 1>&2 | <store-secret-from-stdin>"
  { true >&3; } 2>/dev/null || die "keygen: open file descriptor 3 for the secret key (see the header)"
  KP=$(php_run -r '$k = sodium_crypto_sign_keypair(); echo base64_encode( sodium_crypto_sign_publickey( $k ) ), " ", base64_encode( sodium_crypto_sign_secretkey( $k ) );' | tr -d '\r')
  [[ "${KP%% *}" =~ $KEY_RE && "${KP#* }" =~ ^[A-Za-z0-9+/]{86}==$ ]] || die "keygen: PHP gave no keypair"
  printf '%s' "${KP#* }" >&3
  printf '%s\n' "${KP%% *}"
  exit 0
fi

USAGE="usage: wp-sr-promote --repo <clone> vX.Y.Z <tested> [--rotate] [--dry-run <zip> [--trusted-zip <zip>]], or: wp-sr-promote keygen"
REPO=""; ROTATE=""; DRY=""; TRUSTED_ZIP=""; POS=()
while [ $# -gt 0 ]; do # every path is resolved here, before any cd
  case "$1" in
    --repo) REPO=$(realpath "${2:?--repo needs a clone}"); shift ;;
    --rotate) ROTATE=1 ;;
    --dry-run) DRY=$(realpath "${2:?--dry-run needs a zip}"); shift ;;
    --trusted-zip) TRUSTED_ZIP=$(realpath "${2:?--trusted-zip needs a zip}"); shift ;;
    -*) die "unknown argument: $1" ;;
    *) POS+=("$1") ;;
  esac
  shift
done
[ -n "$REPO" ] && [ ${#POS[@]} -eq 2 ] || die "$USAGE"
TAG=${POS[0]}; TESTED=${POS[1]}
[[ "$TAG" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)$ ]] || die "$USAGE"
V=${BASH_REMATCH[1]}
[[ "$TESTED" =~ $VER_RE ]] || die "bad tested: ${TESTED@Q}"
if [ -n "$DRY" ]; then
  [ -z "$KEY$NEWKEY" ] || die "a dry run never takes the release key: unset PUZZLES_SR_SIGNING_KEY and PUZZLES_SR_NEW_SIGNING_KEY; throwaway keys go in PUZZLES_SR_DRY_RUN_KEY"
  KEY=$DKEY; NEWKEY=$DNEWKEY; KV=PUZZLES_SR_DRY_RUN_KEY; NKV=PUZZLES_SR_DRY_RUN_NEW_KEY
else
  [ -z "$DKEY$DNEWKEY" ] || die "PUZZLES_SR_DRY_RUN_KEY or PUZZLES_SR_DRY_RUN_NEW_KEY is set for a real run"
  [ -z "$TRUSTED_ZIP" ] || die "--trusted-zip is for dry runs only"
  KV=PUZZLES_SR_SIGNING_KEY; NKV=PUZZLES_SR_NEW_SIGNING_KEY
fi
[ -n "$KEY" ] || die "$KV is not set"
if [ -n "$ROTATE" ]; then [ -n "$NEWKEY" ] || die "--rotate needs the new secret key in $NKV"
else [ -z "$NEWKEY" ] || die "$NKV is set without --rotate"; fi

W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
mkdir "$W/nohooks"
cd "$REPO"
g() { git -c core.hooksPath="$W/nohooks" -c core.fsmonitor=false "$@"; } # no hook, no worktree helper
[[ "$(git --version)" =~ ^git\ version\ ([0-9]+)\.([0-9]+) ]] \
  && (( BASH_REMATCH[1] * 100 + BASH_REMATCH[2] >= 240 )) || die "needs git 2.40 or later ($(git --version))"
g rev-parse --git-dir >/dev/null 2>&1 || die "${REPO@Q} is not a git clone"
[ -z "$(g rev-parse --show-prefix)" ] || die "--repo must be the clone's top folder, not ${REPO@Q}"
while read -r k spec; do # the record is local: no fetch may write it
  dst=${spec#*:}
  [ "$dst" = "$spec" ] || [ -z "$dst" ] || [[ "$dst" == refs/remotes/* || "$dst" == refs/tags/* ]] \
    || die "$k fetches into ${dst@Q}: only refs/remotes/ and refs/tags/ may be fetched into (the record is local)"
done <<<"$(g config --get-regexp '^remote\..*\.fetch$' || true)"
REAL_REFS=$(g for-each-ref --format='%(refname)' refs/puzzles-sr/promoted refs/puzzles-sr/pending)
DRY_REFS=$(g for-each-ref --format='%(refname)' refs/puzzles-sr/dry-run)
if [ -n "$DRY" ]; then
  [ -z "$REAL_REFS" ] || die "this clone holds your real promotion record (refs/puzzles-sr/promoted/): run dry runs in a throwaway clone"
  REC=refs/puzzles-sr/dry-run/promoted
else
  [ -z "$DRY_REFS" ] || die "this clone holds dry-run records (refs/puzzles-sr/dry-run/): promote from the clone that holds your real record, never one used for dry runs"
  REC=refs/puzzles-sr/promoted
fi
PEND=refs/puzzles-sr/pending
SHIP=(puzzles-site-reports.php uninstall.php README.md CHANGELOG.md LICENSE includes) # scripts/build.sh's allowlist
CODE=(puzzles-site-reports.php uninstall.php includes)                                # the shipped PHP
ascii() { [ "$(LC_ALL=C tr -d '\11\12\40-\176' | wc -c)" -eq 0 ]; } # stdin: only TAB, LF and printable ASCII
pubkey_of() { tr -d '\r' | sed -n "s/^define( 'PUZZLES_SR_UPDATE_PUBKEY', '\([^']*\)' );\$/\1/p"; } # stdin: a main file
wp_header() { # wp_header <name>, stdin: a main file. As WordPress' get_file_data(): the first 8 KB, \r as \n, the first
  head -c 8192 | tr '\r' '\n' | grep -iE "^([[:blank:]]*<\?php)?[[:blank:]/*#@]*$1:" | head -1 \
    | sed -E "s/^([[:blank:]]*<\?php)?[[:blank:]/*#@]*$1:(.*)\$/\2/I; s/[[:space:]]*(\*\/|\?>).*//; s/^[[:blank:]]+//; s/[[:blank:]]+\$//"
} # matching line, its value trimmed and cut at "*/" or "?>"
sig_ok() { # sig_ok <public keys, space separated> <base64 signature> <message>: one of the keys verifies it
  [ "$(printf '%s\n%s\n%s' "$1" "$2" "$3" | php_run -r '
$keys = preg_split( "/ +/", trim( (string) fgets( STDIN ) ), -1, PREG_SPLIT_NO_EMPTY );
$sig = base64_decode( trim( (string) fgets( STDIN ) ), true );
$msg = stream_get_contents( STDIN );
$ok = false;
foreach ( $keys as $k ) {
	$pk = base64_decode( $k, true );
	if ( is_string( $pk ) && is_string( $sig ) && SODIUM_CRYPTO_SIGN_PUBLICKEYBYTES === strlen( $pk ) && SODIUM_CRYPTO_SIGN_BYTES === strlen( $sig ) && sodium_crypto_sign_verify_detached( $sig, $msg, $pk ) ) {
		$ok = true;
	}
}
echo $ok ? "valid" : "invalid";
' | tr -d '\r')" = valid ]
}
pending() { # pending <ref>: "<commit> <sha256>", the pending record written just before a release went live
  local p; p=$(g cat-file blob "$1" 2>/dev/null) || true
  [[ "$p" =~ ^[0-9a-f]{40,64}\ [0-9a-f]{64}$ ]] || die "$1 is not a pending record this script wrote"
  printf '%s\n' "$p"
}
key_at() { g cat-file blob "$1:puzzles-site-reports.php" | pubkey_of; } # key_at <commit or ref>: the key its main file ships
confirm() { # confirm <what the owner types> <prompt>
  [ -n "$DRY" ] || { [ -t 0 ] && [ -t 2 ]; } \
    || die "a real run shows its review on a terminal and takes your confirmation from it, never from a pipe or a file"
  printf 'wp-sr-promote: %s: ' "$2" >&2
  read -r ANS || true
  [ "$ANS" = "$1" ] || die "not confirmed"
}
MAN_RE='^[{]"version":"([0-9.]+)","sha256":"([0-9a-f]{64})","requires":"([0-9.]+)","requires_php":"([0-9.]+)","tested":"([0-9.]+)","signature":"([A-Za-z0-9+/]{86}==)"[}]$'
manifest() { # manifest <file> <version> <keys>: the sha256 a manifest.json signs for <version>, once one of <keys> verifies it
  local m f
  [ -f "$1" ] || die "the release v$2 has no manifest.json"
  m=$(head -c 1024 "$1" | tr -d '\r\n')
  [[ "$m" =~ $MAN_RE ]] || die "v$2's manifest.json is not one this script writes"
  f=("${BASH_REMATCH[@]:1}")
  [ "${f[0]}" = "$2" ] || die "v$2's manifest is for version ${f[0]}"
  sig_ok "$3" "${f[5]}" "${f[0]}"$'\n'"${f[1]}"$'\n'"${f[2]}"$'\n'"${f[3]}"$'\n'"${f[4]}" \
    || die "v$2's manifest is not signed by the key of a promotion recorded in this clone (after a key rotation, a clone also needs the record of the release before the rotation: README, Release)"
  printf '%s\n' "${f[1]}"
}
PATH_RE='^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$'
DEV_RE='/(con|prn|aux|nul|com[0-9]|lpt[0-9])(\.[^/]*)?/'
stage() { # stage <commit> <dir> <name>: the commit's shipped files, read as blobs into <dir>/stage/puzzles-site-reports,
  local c=$1 s="$2/stage/puzzles-site-reports" n=$3 sr e p mode sha l d a v bad="" # each entry checked before it is
  local -a entries=() files=()                                                     # written
  local -A seen=() # lowercased path -> f (a file) or d (a directory)
  mkdir -p "$s"; sr=$(realpath "$s")
  mapfile -d '' entries < <(g ls-tree -r -z --full-tree "$c" -- "${SHIP[@]}")
  for e in "${entries[@]}"; do
    p="${e#*$'\t'}"; read -r mode _ sha <<<"${e%%$'\t'*}"; l="${p,,}"
    [[ "$p" =~ $PATH_RE ]] || die "$n has the path ${p@Q}"
    case "$p" in
      puzzles-site-reports.php | uninstall.php | README.md | CHANGELOG.md | LICENSE | includes/*) ;;
      *) die "$n's ${p@Q} is not a shipped file (a shipped name that is a directory?)" ;;
    esac
    [ "$mode" = 100644 ] || [ "$mode" = 100755 ] || die "$n has ${p@Q} with mode $mode (a symlink or a submodule)"
    [[ ! "/$l/" =~ $DEV_RE ]] || die "$n's ${p@Q} has a reserved device name on Windows"
    [[ "$p/" != *./* ]] || die "$n's ${p@Q} has a name ending in '.', which Windows drops"
    [ -z "${seen[$l]:-}" ] || die "$n's ${p@Q} and another entry are one name on Windows (case-insensitive)"
    seen[$l]=f; d=$l
    while [[ "$d" == */* ]]; do
      d=${d%/*}; [ "${seen[$d]:-d}" = d ] || die "$n's ${p@Q} and another entry are one name on Windows (case-insensitive)"
      seen[$d]=d
    done
    mkdir -p -- "$s/$(dirname -- "$p")"
    g cat-file blob "$sha" >"$s/$p"
    case "$(realpath -- "$s/$p")" in "$sr"/*) ;; *) die "$n's ${p@Q} was written outside the staging directory" ;; esac
    ascii <"$s/$p" || die "$n's ${p@Q} has a byte other than TAB, LF and printable ASCII" # every file: nothing hides
    [[ "$p" == *.php ]] || ! grep -qF '<?' "$s/$p" || die "$n's ${p@Q} is not PHP but holds a PHP open tag ('<?'): included, it would run"
    files+=("$p")
  done
  printf '%s\0' "${files[@]}" | g check-attr -z --source="$c" --stdin filter ident working-tree-encoding eol >"$2/attrs" \
    || die "git check-attr --source failed"
  while IFS= read -r -d '' p && IFS= read -r -d '' a && IFS= read -r -d '' v; do
    case "$a=$v" in *=unspecified | *=unset | eol=lf) ;; *) bad+=" ${p@Q}: $a=$v;" ;; esac
  done <"$2/attrs"
  [ -z "$bad" ] || die "$n assigns git attributes that change a shipped file on checkout:$bad"
}
PY=python3; "$PY" -I -c '' 2>/dev/null || PY=python # python3 may be a Windows store stub
build() { # build <dir> <version>: scripts/build.sh's version rewrite and zip of <dir>/stage, byte for byte (the test
  sed -i -E "s/^( \* Version:) +[0-9]+\.[0-9]+\.[0-9]+\$/\1 $2/; s/^(define\( 'PUZZLES_SITE_REPORTS_VERSION', ')[0-9]+\.[0-9]+\.[0-9]+(' \);)\$/\1$2\2/" \
    "$1/stage/puzzles-site-reports/puzzles-site-reports.php" # compares the two); prints the zip's sha256
  (cd "$1" && "$PY" -I - <<'PYEOF'
import os, zipfile
names = sorted(os.path.relpath(os.path.join(d, f), 'stage').replace(os.sep, '/') for d, _, fs in os.walk('stage') for f in fs)
with zipfile.ZipFile('puzzles-site-reports.zip', 'w') as z:
    for n in names:
        i = zipfile.ZipInfo(n, (1980, 1, 1, 0, 0, 0))  # ZIP_STORED by default
        i.create_system = 3                              # Unix, whatever machine builds it
        i.external_attr = 0o100644 << 16                 # a regular file, rw-r--r--
        with open(os.path.join('stage', n), 'rb') as f:
            z.writestr(i, f.read())
PYEOF
  )
  sha256sum "$1/puzzles-site-reports.zip" | cut -c1-64
}
signed_build() { # signed_build <commit or ref> <version> <signed sha256> <name>: a record is the commit that was signed
  local d b; d=$(mktemp -d "$W/rec.XXXX")
  stage "$1" "$d" "$4"; b=$(build "$d" "$2")
  [ "$b" = "$3" ] || die "$4 does not build the zip that was signed for v$2 (sha256 $b, signed $3): a record must be the commit that was promoted, never one read from a tag that may have moved (README, Release)"
}

# 1. The tag: one commit, locally and on origin, on origin's main.
COMMIT=$(g rev-parse --verify --quiet "refs/tags/$TAG^{commit}") || die "no local tag $TAG (git fetch origin tag $TAG)"
if [ -z "$DRY" ]; then
  [[ "$(g config --get remote.origin.url)" =~ ^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)$GH_REPO(\.git)?$ ]] \
    || die "origin is not github.com/$GH_REPO"
fi
g fetch --quiet --no-tags origin refs/heads/main # never a tag that happens to be named main
MAINTIP=$(g rev-parse --verify FETCH_HEAD^{commit})
REMOTE=$(g ls-remote --tags origin | awk -v t="refs/tags/$TAG" '$2 == t "^{}" { p = $1 } $2 == t { c = $1 } END { print (p != "" ? p : c) }')
[ "$REMOTE" = "$COMMIT" ] || die "origin's $TAG is '${REMOTE:-missing}', the local one is $COMMIT"
g merge-base --is-ancestor "$COMMIT" "$MAINTIP" || die "$TAG ($COMMIT) is not on origin/main"

# 2. The key and version sites have now, and the owner's record.
CURZIP=""; CUR=""; CURV=""; CURSHA=""; TRUSTED=""; FIRST=""; KEYS=""
if [ -n "$DRY" ]; then CURZIP=$TRUSTED_ZIP
elif CUR=$(gh api "repos/$GH_REPO/releases/latest" --jq .tag_name 2>"$W/gh-err"); then
  [[ "$CUR" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "the latest release's tag is ${CUR@Q}"
  mkdir "$W/cur"; gh release download "$CUR" --pattern puzzles-site-reports.zip --pattern manifest.json --dir "$W/cur"
  CURZIP="$W/cur/puzzles-site-reports.zip"
else
  grep -q 'HTTP 404' "$W/gh-err" || { cat "$W/gh-err" >&2; die "could not read the latest release"; }
  [ -z "$ROTATE" ] || die "--rotate, but no release was promoted yet"
  FIRST=1
fi
LAST=$(g for-each-ref --sort=-version:refname --count=1 --format='%(refname)' "$REC"); LV=""
if [ -n "$LAST" ]; then
  LV=${LAST##*/}
  [[ "$LV" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "${LAST@Q} is not a record this script wrote"
  BASE=$(g rev-parse --verify "$LAST^{commit}"); BL="$LV, your last promotion recorded in this clone ($LAST)"
else
  BASE=$(g hash-object -t tree --stdin </dev/null); BL="none: the first promotion recorded in this clone: everything is new"
fi
if [ -n "$CURZIP" ]; then # read as data: one file to stdout, nothing extracted
  CURMAIN=$(unzip -p "$CURZIP" puzzles-site-reports/puzzles-site-reports.php | tr -d '\r')
  TRUSTED=$(pubkey_of <<<"$CURMAIN"); CURV=$(wp_header Version <<<"$CURMAIN")
  [[ "$TRUSTED" =~ $KEY_RE && "$CURV" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "cannot read the latest release's key and version"
fi
if [ -n "$CUR" ]; then # a real run: the latest release is one a promotion here signed
  [ "$CUR" = "v$CURV" ] || die "the latest release $CUR carries version $CURV"
  for r in $(g for-each-ref --format='%(refname)' "$REC"); do KEYS+=" $(key_at "$r")"; done
  for r in $(g for-each-ref --format='%(refname)' "$PEND"); do P=$(pending "$r"); KEYS+=" $(key_at "${P%% *}")"; done
  KEYS=${KEYS:-$TRUSTED} # its own key only in a clone with no record
  CURSHA=$(manifest "$W/cur/manifest.json" "$CURV" "$KEYS")
  [ "$CURSHA" = "$(sha256sum "$CURZIP" | cut -c1-64)" ] || die "$CUR's manifest does not match its zip"
fi
CURREC=""; [ -z "$CURV" ] || ! g rev-parse --quiet --verify "$REC/v$CURV" >/dev/null || CURREC=1
if [ -n "$CUR" ] && [ -z "$CURREC" ] && g rev-parse --quiet --verify "$PEND/$CUR" >/dev/null; then
  P=$(pending "$PEND/$CUR"); PC=${P%% *}; PSHA=${P#* }
  [ "$PSHA" = "$CURSHA" ] || die "$CUR's live zip (sha256 $CURSHA) is not the one the interrupted run here signed ($PSHA)"
  signed_build "$PC" "$CURV" "$CURSHA" "the pending $CUR ($PC)"
  echo "wp-sr-promote: GitHub's latest release, $CUR, is live with the zip a run here signed, but that run stopped before recording it ($PEND/$CUR: commit $PC)" >&2
  confirm "$CURV" "type $CURV to record $CUR as promoted"
  g update-ref -m "wp-sr-promote: recorded after an interrupted run" "$REC/$CUR" "$PC"; g update-ref -d "$PEND/$CUR"
  if [ "$CUR" = "$TAG" ]; then echo "promoted $TAG (it was already live); recorded as $REC/$TAG: nothing left to do"
  else echo "recorded $CUR as promoted ($REC/$CUR); run again to promote $TAG"; fi
  exit 0
fi
if [ -n "$LAST" ] && [ -n "$FIRST" ]; then
  die "GitHub has no latest release, but this clone records $LV as promoted: was your first promotion marked pre-release? Restore it (gh release edit $LV --prerelease=false --latest), then promote the next release; or delete the record and start over (README, Release, Bad release)"
elif [ -n "$LAST" ] && [ -n "$CURV" ] && [ -z "$CURREC" ]; then
  die "the latest release on GitHub is v$CURV, not a promotion recorded in this clone (your last: $LV): GitHub's release state does not match your record; find out why before promoting anything (README, Release)"
fi
if [ -n "$LAST" ] && [ -n "$TRUSTED" ]; then
  LK=$(key_at "$LAST")
  [ "$LK" = "$TRUSTED" ] || die "the latest release on GitHub (v$CURV) carries the key $TRUSTED, but your last promotion recorded in this clone ($LV) ships $LK: GitHub's latest is not the release your record expects (a key-rotation release marked pre-release? README, Release)"
fi
[ -z "$CURV" ] || printf '%s\n' "$CURV" "$V" | sort -VCu || die "$TAG is not newer than the latest release ($CURV)"
[ -z "$LV" ] || printf '%s\n' "${LV#v}" "$V" | sort -VCu || die "$TAG is not newer than your last promotion recorded in this clone ($LV)"
# The records are what was signed: the latest release's record and the highest one build to their signed zips.
if [ -n "$CURREC" ] && [ -n "$CUR" ]; then signed_build "$REC/$CUR" "$CURV" "$CURSHA" "your record $CUR"
elif [ -n "$CURREC" ]; then signed_build "$REC/v$CURV" "$CURV" "$(sha256sum "$TRUSTED_ZIP" | cut -c1-64)" "your record v$CURV"; fi
if [ -n "$LAST" ] && [ -z "$DRY" ] && [ "$LV" != "v$CURV" ]; then # a dry run has no manifest for it
  mkdir "$W/last"; gh release download "$LV" --pattern manifest.json --dir "$W/last"
  LSHA=$(manifest "$W/last/manifest.json" "${LV#v}" "$KEYS")
  signed_build "$LAST" "${LV#v}" "$LSHA" "your record $LV"
fi

# 3. The tag's shipped files, staged and checked; what runs before the key define; the review.
stage "$COMMIT" "$W" "$TAG"
S="$W/stage/puzzles-site-reports"; MAINF="$S/puzzles-site-reports.php"
[ -f "$MAINF" ] || die "$TAG has no puzzles-site-reports.php"
STRICT_V='^ \* Version: +[0-9]+\.[0-9]+\.[0-9]+$'
STRICT_D="^define\\( 'PUZZLES_SITE_REPORTS_VERSION', '[0-9]+\\.[0-9]+\\.[0-9]+' \\);\$"
HDR=$(head -c 8192 "$MAINF" | grep -iE '^([[:blank:]]*<\?php)?[[:blank:]/*#@]*Version:' || true) # every line WordPress could read
[[ "$HDR" =~ $STRICT_V ]] && [ "$(grep -ciE '^[[:blank:]/*#@]*Version:' "$MAINF" || true)" = 1 ] \
  && [ "$(grep -c "PUZZLES_SITE_REPORTS_VERSION'" "$MAINF" || true)" = 1 ] && grep -qE "$STRICT_D" "$MAINF" \
  || die "$TAG's main file needs exactly one version header line as WordPress reads it, ' * Version: X.Y.Z', and exactly one \"define( 'PUZZLES_SITE_REPORTS_VERSION', 'X.Y.Z' );\" line, and no other line like them"
# The key define runs first, at top level: PHP keeps the first define of a constant, so nothing later can change it.
KEYLINE="^define\\( 'PUZZLES_SR_UPDATE_PUBKEY', '[A-Za-z0-9+/]{43}=' \\);\$"
[ "$(grep -cE "$KEYLINE" "$MAINF" || true)" = 1 ] \
  || die "$TAG's main file needs its key on one top-level line: define( 'PUZZLES_SR_UPDATE_PUBKEY', '<base64 key>' );"
DEFL=$(grep -nE "$KEYLINE" "$MAINF" | cut -d: -f1)
mapfile -t PRE < <(head -n $((DEFL - 1)) "$MAINF")
Q="'"; LITDEF="^define\\( ${Q}[A-Z0-9_]+${Q}, ${Q}[^${Q}\\\\]*${Q} \\);\$" # define( 'NAME', 'a literal' );
before() { die "$TAG's main file has ${1@Q} before its key define: only the header comment, blank lines, // comments, the ABSPATH guard and literal define( 'NAME', 'value' ); lines may come first"; }
[ "${PRE[0]:-}" = '<?php' ] || before "${PRE[0]:-}"
INC=""
for (( i = 1; i < ${#PRE[@]}; i++ )); do
  l=${PRE[i]}
  if [ -n "$INC" ]; then # inside the header comment: nothing may end it but its own " */" line
    if [ "$l" = ' */' ]; then INC=""; else [[ "$l" != *'*/'* ]] || before "$l"; fi
    continue
  fi
  case "$l" in
    '/**') INC=1 ;;
    '') ;;
    "if ( ! defined( 'ABSPATH' ) ) {") [ "${PRE[i+1]:-}" = $'\texit;' ] && [ "${PRE[i+2]:-}" = '}' ] || before "$l"; i=$((i + 2)) ;;
    //*) [[ "$l" != *'?>'* ]] || before "$l" ;; # ?> would end PHP inside a // comment
    *) [[ "$l" =~ $LITDEF ]] || before "$l" ;;
  esac
done
[ -z "$INC" ] || before '/**'
# Tripwires (header, 3). grep -a: a file grep takes for binary is still read.
HITS=$(cd "$S" && { grep -rlia PUZZLES_SR_UPDATE_PUBKEY "${CODE[@]}" 2>/dev/null || true; })
[ "$HITS" = puzzles-site-reports.php ] || die "PUZZLES_SR_UPDATE_PUBKEY appears outside the main file in $TAG: $(echo $HITS)"
[ "$(grep -ciaE '(define|const)[^;]*PUZZLES_SR_UPDATE_PUBKEY' "$MAINF")" = 1 ] || die "$TAG defines PUZZLES_SR_UPDATE_PUBKEY more than once"
PHAR=$(cd "$S" && { grep -rliaE 'phar:|\.phar' "${CODE[@]}" 2>/dev/null || true; })
[ -z "$PHAR" ] || die "$TAG's shipped PHP names a phar: $(echo $PHAR)"
CONST_RE='(^|[^A-Za-z0-9_$>:])const([^A-Za-z0-9_]|$)'
ODD=$(cd "$S" && {
  grep -rniaE "constant[[:space:]]*\(|PUZZLES_[A-Z0-9_]*['\"][[:space:]]*\." "${CODE[@]}" 2>/dev/null || true
  grep -rniaE 'define[[:space:]]*\(' "${CODE[@]}" 2>/dev/null \
    | grep -viaE "define[[:space:]]*\([[:space:]]*['\"][A-Z0-9_]+['\"][[:space:]]*," || true
  grep -rniaE "$CONST_RE" "${CODE[@]}" 2>/dev/null | grep -viaE 'const[[:space:]]+[A-Z0-9_]+[[:space:]]*=.*;' || true
})
[ -z "$ODD" ] || die "$TAG's shipped PHP names a constant in a way these checks cannot follow: $ODD"
TWICE=$(cd "$S" && { grep -rhoiaE "define[[:space:]]*\([[:space:]]*['\"][A-Z0-9_]+|$CONST_RE[[:space:]]*[A-Z0-9_]+" "${CODE[@]}" 2>/dev/null || true; } \
  | grep -oiaE '[A-Z0-9_]+$' | tr a-z A-Z | sort | uniq -d)
[ -z "$TWICE" ] || die "$TAG's shipped PHP defines a constant more than once: $(echo $TWICE)"
NEWPUB=$(pubkey_of <"$MAINF")
[[ "$NEWPUB" =~ $KEY_RE ]] || die "$TAG's PUZZLES_SR_UPDATE_PUBKEY is not one base64 Ed25519 public key: '$NEWPUB'"
REQ=$(wp_header 'Requires at least' <"$MAINF"); REQPHP=$(wp_header 'Requires PHP' <"$MAINF")
[[ "$REQ" =~ $VER_RE && "$REQPHP" =~ $VER_RE ]] || die "bad Requires header: ${REQ@Q} ${REQPHP@Q}"

{
  echo "wp-sr-promote: $TAG is commit $COMMIT"
  echo "wp-sr-promote: baseline: $BL"
  echo "wp-sr-promote: every file $TAG ships, baseline -> $TAG, in full:"
  g --no-pager diff --no-color --no-ext-diff --no-textconv --text "$BASE" "$COMMIT" -- "${SHIP[@]}" | cat -v
  echo "wp-sr-promote: in short, baseline -> $TAG:"
  g --no-pager diff --no-color --stat=200 "$BASE" "$COMMIT" -- "${SHIP[@]}" | cat -v
} >&2
confirm "$V" "review the diff above, then type $V to sign $TAG"

# 4. Build that tree; the release zip must be the same bytes.
BUILT=$(build "$W" "$V")
if [ -n "$DRY" ]; then ZIP=$DRY
else mkdir "$W/rel"; gh release download "$TAG" --pattern puzzles-site-reports.zip --dir "$W/rel"; ZIP="$W/rel/puzzles-site-reports.zip"; fi
SHA=$(sha256sum "$ZIP" | cut -c1-64)
[ "$SHA" = "$BUILT" ] || die "the release zip (sha256 $SHA) is not what this promoter builds from $TAG ($BUILT). If the tag's scripts/build.sh changed the zip's bytes, this promoter needs the same change: review it and re-install (README, Release)"

# Sign. stdin: the key, the new key (or an empty line), then the message exactly. Prints "<pub> <new pub or -> <sig>".
[ -z "$FIRST" ] || TRUSTED=$NEWPUB
MSG="$V"$'\n'"$SHA"$'\n'"$REQ"$'\n'"$REQPHP"$'\n'"$TESTED"
OUT=$(printf '%s\n%s\n%s' "$KEY" "$NEWKEY" "$MSG" | php_run -r '
$sk = function ( $line ) {
	$k = base64_decode( trim( (string) $line ), true );
	if ( ! is_string( $k ) || SODIUM_CRYPTO_SIGN_SECRETKEYBYTES !== strlen( $k ) ) { fwrite( STDERR, "not a base64 Ed25519 secret key\n" ); exit( 1 ); }
	return $k;
};
$k = $sk( fgets( STDIN ) );
$n = trim( (string) fgets( STDIN ) );
$np = "" === $n ? "-" : base64_encode( sodium_crypto_sign_publickey_from_secretkey( $sk( $n ) ) );
echo base64_encode( sodium_crypto_sign_publickey_from_secretkey( $k ) ), " ", $np, " ", base64_encode( sodium_crypto_sign_detached( stream_get_contents( STDIN ), $k ) );
' | tr -d '\r')
read -r PUB PROOF SIG <<<"$OUT"
[[ "$PUB" =~ $KEY_RE && "$SIG" =~ ^[A-Za-z0-9+/]{86}==$ ]] || die "signing failed"
if [ -n "$ROTATE" ]; then
  [ "$PROOF" = "$NEWPUB" ] || die "$NKV is not the secret key of $TAG's PUZZLES_SR_UPDATE_PUBKEY ($NEWPUB)"
fi
if [ -n "$TRUSTED" ]; then
  [ "$PUB" = "$TRUSTED" ] || die "the signing key's public key ($PUB) is not the one sites trust now ($TRUSTED)"
  if [ -n "$ROTATE" ]; then
    [ "$NEWPUB" != "$TRUSTED" ] || die "--rotate, but $TAG keeps the key sites trust now"
    echo "wp-sr-promote: rotating: after $TAG, sites trust only $NEWPUB" >&2
  else
    [ "$NEWPUB" = "$TRUSTED" ] || die "$TAG changes the release key to $NEWPUB; pass --rotate (with $NKV) if that is intended"
  fi
else
  echo "wp-sr-promote: dry run without --trusted-zip: the key, version and record checks are skipped" >&2
fi
if [ -n "$DRY" ]; then # every release key the clone's HEAD history carried, read from each commit's main file
  KNOWN=$(for c in $(g rev-list HEAD -- puzzles-site-reports.php); do
    g cat-file blob "$c:puzzles-site-reports.php" 2>/dev/null | pubkey_of || true # a commit that deletes it has none
  done)
  ! grep -qxF -- "$PUB" <<<"$KNOWN" || die "dry run with a release key: use a throwaway key (wp-sr-promote keygen)"
fi

printf '{"version":"%s","sha256":"%s","requires":"%s","requires_php":"%s","tested":"%s","signature":"%s"}\n' \
  "$V" "$SHA" "$REQ" "$REQPHP" "$TESTED" "$SIG" >"$W/manifest.json"
if [ -n "$DRY" ]; then cat "$W/manifest.json"; g update-ref -m "wp-sr-promote --dry-run" "$REC/$TAG" "$COMMIT"; exit 0; fi
PB=$(printf '%s %s\n' "$COMMIT" "$SHA" | g hash-object -w --stdin) # a run stopped after the edit below is recoverable (2)
g update-ref -m "wp-sr-promote: going live" "$PEND/$TAG" "$PB"
gh release upload "$TAG" "$W/manifest.json" --clobber
gh release edit "$TAG" --prerelease=false --latest
g update-ref -m "wp-sr-promote" "$REC/$TAG" "$COMMIT"; g update-ref -d "$PEND/$TAG" # the record: local only, never pushed
echo "promoted $TAG (sha256 $SHA); recorded as $REC/$TAG"
